  "scenarios": [
    {
      "name": "수동 운전",
      "steps": [
        {
          "action": "power_on"
        },
        {
          "expect": {
            "GL": "on",
            "MC1": "off"
          }
        },
        {
          "action": "hold",
          "target": "PB1"
        },
        {
          "expect": {
            "MC1": "on",
            "RL": "on",
            "GL": "off"
          }
        },
        {
          "action": "release",
          "target": "PB1"
        },
        {
          "expect": {
            "MC1": "off",
            "GL": "on"
          }
        }
      ]
    },
    {
      "name": "자동 급수",
      "steps": [
        {
          "action": "toggle",
          "target": "SS",
          "value": true
        },
        {
          "action": "set_level",
          "target": "FLS",
          "level": "low"
        },
        {
          "expect": {
            "MC1": "on",
            "RL": "on"
          }
        },
        {
          "action": "set_level",
          "target": "FLS",
          "level": "mid"
        },
        {
          "expect": {
            "MC1": "on"
          }
        },
        {
          "action": "set_level",
          "target": "FLS",
          "level": "high"
        },
        {
          "expect": {
            "MC1": "off",
            "GL": "on"
          }
        },
        {
          "action": "set_level",
          "target": "FLS",
          "level": "mid"
        },
        {
          "expect": {
            "MC1": "off"
          }
        },
        {
          "action": "set_level",
          "target": "FLS",
          "level": "low"
        },
        {
          "expect": {
            "MC1": "on"
          }
        }
      ]
    }
  ]
