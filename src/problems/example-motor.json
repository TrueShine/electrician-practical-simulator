          "expect": {
            "BZ": "on",
            "MC1": "on"
          }
        }
      ]
    },
    {
      "name": "정지",
      "steps": [
        {
          "action": "press",
          "target": "PB0",
          "durationMs": 300
        },
        {
          "expect": {
            "MC1": "off",
            "RL": "off",
            "GL": "on",
            "BZ": "off"
          }
        }
      ]
    },
    {
      "name": "과부하 트립",
      "steps": [
        {
          "action": "press",
          "target": "PB1",
          "durationMs": 300
        },
        {
          "action": "toggle",
          "target": "EOCR",
          "value": true
        },
        {
          "expect": {
            "MC1": "off",
            "YL": "on",
            "GL": "on"
          }
        },
        {
          "action": "toggle",
          "target": "EOCR",
          "value": false
        },
        {
          "expect": {
            "YL": "off",
            "MC1": "off"
          }
        }
      ]
    }
